import typing

class Formatter:
    def __init__(self) -> None: ...
    def format(self, arg0: object) -> str: ...

class MutInt:
    value: int
    def __init__(self, arg0: typing.SupportsInt | typing.SupportsIndex) -> None: ...
    def __add__(self, arg0: typing.SupportsInt | typing.SupportsIndex) -> MutInt: ...
    def __bool__(self) -> bool: ...
    def __iadd__(self, arg0: typing.SupportsInt | typing.SupportsIndex) -> MutInt: ...
    def __index__(self) -> int: ...
    def __int__(self) -> int: ...
    def __isub__(self, arg0: typing.SupportsInt | typing.SupportsIndex) -> MutInt: ...
    def __sub__(self, arg0: typing.SupportsInt | typing.SupportsIndex) -> MutInt: ...

class VERBOSE(MutInt):
    lvalue: int
    def __init__(self, parsed_lvalue: typing.SupportsInt | typing.SupportsIndex) -> None: ...
    def disable(self) -> None: ...
    def enable(self) -> None: ...
    def pause(self) -> None: ...
    def resume(self) -> None: ...
