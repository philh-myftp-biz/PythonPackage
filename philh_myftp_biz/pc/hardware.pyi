import typing
from typing import ClassVar

class Device:
    def __init__(self) -> None: ...
    def _pybind11_conduit_v1_(self, *args, **kwargs): ...
    @staticmethod
    def search() -> list[Device]: ...
    @property
    def Connected(self) -> bool: ...
    @property
    def FriendlyName(self) -> str: ...
    @property
    def Health(self) -> HealthStatus: ...
    @property
    def HealthReport(self) -> str: ...
    @property
    def ID(self) -> int: ...
    @property
    def Link(self) -> str: ...
    @property
    def Name(self) -> str: ...

class HardDrive(Device):
    FriendlyName: str
    Usage: str
    def __init__(self, Tower: str, Conn: str, Slot: typing.SupportsInt | typing.SupportsIndex, SN: str) -> None: ...
    def _pybind11_conduit_v1_(self, *args, **kwargs): ...
    @staticmethod
    def search() -> list[HardDrive]: ...
    @property
    def Conn(self) -> str: ...
    @property
    def Index(self) -> int: ...
    @property
    def SN(self) -> str: ...
    @property
    def Slot(self) -> int: ...
    @property
    def Tower(self) -> str: ...

class HealthStatus:
    __members__: ClassVar[dict] = ...  # read-only
    HEALTHY: ClassVar[HealthStatus] = ...
    NOTGOOD: ClassVar[HealthStatus] = ...
    UNKNOWN: ClassVar[HealthStatus] = ...
    WARNING: ClassVar[HealthStatus] = ...
    __entries: ClassVar[dict] = ...
    def __init__(self, value: typing.SupportsInt | typing.SupportsIndex) -> None: ...
    def _pybind11_conduit_v1_(self, *args, **kwargs): ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def __index__(self) -> int: ...
    def __int__(self) -> int: ...
    def __ne__(self, other: object) -> bool: ...
    @property
    def name(self) -> str: ...
    @property
    def value(self) -> int: ...

class PCIeCard(Device):
    def __init__(self, VendorID: typing.SupportsInt | typing.SupportsIndex, DeviceID: typing.SupportsInt | typing.SupportsIndex, Slot: typing.SupportsInt | typing.SupportsIndex, Lanes: typing.SupportsInt | typing.SupportsIndex = ...) -> None: ...
    def _pybind11_conduit_v1_(self, *args, **kwargs): ...
    @staticmethod
    def search() -> list[PCIeCard]: ...
    @property
    def DeviceID(self) -> int: ...
    @property
    def Lanes(self) -> int: ...
    @property
    def Slot(self) -> int: ...
    @property
    def VendorID(self) -> int: ...

class VirtualDisk(Device):
    Connected: bool
    def __init__(self, Name: str, Mount: str) -> None: ...
    def Repair(self) -> None: ...
    def _pybind11_conduit_v1_(self, *args, **kwargs): ...
    @property
    def Mount(self) -> str: ...
